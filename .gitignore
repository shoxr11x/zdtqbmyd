# ── Что НЕ попадает в репозиторий ────────────────────────────────────────────

# Ключ от сертификата. Попади он в репозиторий — его пришлось бы перевыпускать.
certs/

# Виртуальное окружение: несколько гигабайт, ставится командой из README
.venv/

# Снятые кадры и разметка — это данные, а не код. Плюс на них цех и руки.
dataset/

# Обученные модели и ход обучения: десятки мегабайт, пересоздаются обучением
models/*.pt
runs/
*.pt

# Рабочее состояние: счётчики смены и журнал пересечений
state.json
events.jsonl

# Локальные настройки и мусор
.env
__pycache__/
*.pyc
backup/
